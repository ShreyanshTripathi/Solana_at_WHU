# Copy to .env.local to override defaults.
SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_PATH=data/kiezwatt.db

# Login (Module 16). Generate the secret with: openssl rand -base64 32
SESSION_SECRET=
# Privy: dashboard.privy.io -> your app. Enable email + passkey login, Solana embedded wallets,
# and "Return user data in an identity token". Paste the verification key with \n for line breaks.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Needed to delete a member's Privy login when they delete their account. Server only, never NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# One-click demo accounts on /login. Never set this in production.
DEMO_LOGIN=false
